# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it holds secrets.

# Get this from MongoDB Atlas after creating your free cluster.
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/skillswap
MONGO_URI=your_mongodb_atlas_connection_string_here

# Any long random string works — used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_string

# Gmail account used to SEND the OTP emails during registration.
# GMAIL_APP_PASSWORD is NOT your normal Gmail password — see README for
# how to generate one (requires 2-Step Verification to be turned on).
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Free Google Gemini API key — powers the AI chatbot assistant.
# Get one at https://aistudio.google.com/app/apikey (no credit card needed).
GEMINI_API_KEY=your_gemini_api_key_here

# Port the backend server runs on.
PORT=5000
